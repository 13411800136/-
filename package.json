{
  "name": "factory-collab-system",
  "version": "1.3.0",
  "private": true,
  "description": "厂序 · 工厂业务协同管理系统（第三轮考核）",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "node backend/dist/server.js",
    "migrate": "npm run migrate -w backend",
    "seed": "npm run seed -w backend -- --yes",
    "setup": "npm run migrate && npm run seed",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "test": "npm run test -w backend",
    "test:unit": "npm run test:unit -w backend",
    "test:integration": "npm run test:integration -w backend",
    "test:e2e": "playwright test",
    "test:acceptance": "node backend/scripts/acceptance/smoke.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "concurrently": "9.2.1",
    "typescript": "5.9.3"
  }
}
