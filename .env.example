# 厂序 FactoryFlow · 配置模板
# 复制为 .env 后按本机情况修改；不要把真实密码、令牌或生产库地址写入本文件。

NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# 数据库与附件路径：相对路径以项目根目录为基准；生产运行数据必须放在仓库外或忽略目录。
DATABASE_PATH=data/factory.db
UPLOAD_DIR=data/uploads
PUBLIC_DIR=frontend/dist

# 允许的浏览器来源（逗号分隔）。localhost 与 127.0.0.1 视为不同来源。
APP_ORIGIN=http://127.0.0.1:8787,http://localhost:8787,http://127.0.0.1:5173,http://localhost:5173

# 会话有效期（小时）与 Cookie Secure（HTTPS 部署时设为 true）
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# 演示模式：仅合成账号；生产环境必须设为 false
DEMO_MODE=true
DEMO_PASSWORD=Demo@2026

# 附件：仅 PDF；大小上限（MB，1-50）
MAX_UPLOAD_MB=5

# 认证 pepper：至少 32 字符。生产环境必填；开发环境缺省时会在 data/.auth-secret 自动生成。
AUTH_PEPPER=replace-with-at-least-32-random-characters

LOG_LEVEL=info

# 备份目录（备份脚本使用；默认 backups/）
BACKUP_DIR=backups
